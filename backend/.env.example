# PaperMind backend configuration
# Copy this file to backend/.env and fill in the values.
# The app refuses to boot with a readable error naming any variable left empty.

# --- Database (required) ---
# Local Postgres via `docker compose up`: postgresql+psycopg://papermind:papermind@localhost:5432/papermind
DATABASE_URL=

# --- Vector database (choose with VECTOR_BACKEND) ---
# VECTOR_BACKEND: "qdrant" (default, free local) or "pinecone" (paid fallback)
# - qdrant: local via `docker compose up` on http://localhost:6333, no API key needed.
#   Data is persisted to the `qdrant_storage` volume (collection: pdf-index).
# - pinecone: requires PINECONE_API_KEY; keep for existing setups.
VECTOR_BACKEND=qdrant
# Qdrant URL (default: http://localhost:6333 locally, http://qdrant:6333 inside compose)
# QDRANT_URL=http://localhost:6333
# Pinecone API key (required only when VECTOR_BACKEND=pinecone)
PINECONE_API_KEY=

# --- Embeddings (choose with EMBED_BACKEND) ---
# EMBED_BACKEND: "local" (default, free) or "gemini" (paid fallback)
# - local: BAAI/bge-m3 via sentence-transformers, CPU, 8192 context, 1024d
#   Matryoshka, normalized for cosine. No API key; weights (~2GB) download
#   on first run and are cached to the Docker volume `hf_cache` (HF_HOME).
#   Override model via LOCAL_EMBEDDING_MODEL if needed.
# - gemini: gemini-embedding-001 (768d), requires GOOGLE_API_KEY.
EMBED_BACKEND=local
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# LOCAL_EMBED_DIM=1024

# --- Chat provider (choose with MODE) ---
# MODE: "google" (default) or "groq" — picks who answers chat requests.
# The matching API key below is required for the chosen mode.
MODE=google
# Google AI Studio API key (required when MODE=google or EMBED_BACKEND=gemini)
GOOGLE_API_KEY=
# Groq API key (required when MODE=groq)
GROQ_API_KEY=
# Optional: override the Groq chat model
GROQ_MODEL=openai/gpt-oss-120b

# --- Auth ---
# DEMO_MODE=true lets anyone use the app without logging in (recruiter demo).
# When false, user-facing endpoints require a JWT from /auth/login.
DEMO_MODE=false
# Optional: secret for signing JWTs. When unset, a random per-process secret
# is used — fine for demos, but set this in any shared deployment or issued
# tokens stop working after a restart.
# JWT_SECRET=change-me

# --- Hybrid retrieval ---
# HYBRID_ALPHA: dense weight for Pinecone alpha blend; Qdrant uses RRF(k=60).
# Tuned over [0.3,0.5,0.7,0.9] against backend/evaluation/fixture.json:
# keyword queries (proper nouns, table values) favour BM25 -> 0.3, natural
# QA favours dense -> 0.7. Sweet spot 0.7 lifts recall@5 vs dense-only.
# FETCH_K=50 candidates fused via RRF(k=60) before shaping to 5.
# HYBRID_ALPHA=0.7
# FETCH_K=50
# RRF_K=60

# --- Local storage ---
# Optional: directory for uploaded PDFs (default: backend/data/storage)
# STORAGE_DIR=/absolute/path/to/uploads
