# PaperMind backend configuration
# Copy this file to backend/.env and fill in the values.
# The app refuses to boot with a readable error naming any variable left empty.

# --- Database (required) ---
# Local Postgres via `docker compose up`: postgresql+psycopg://papermind:papermind@localhost:5432/papermind
DATABASE_URL=

# --- Vector store (Qdrant) ---
# Local via `docker compose up` on http://localhost:6333, no API key needed.
# Data is persisted to the `qdrant_storage` volume (collection: pdf-index).
# QDRANT_URL: defaults to http://localhost:6333 locally, http://qdrant:6333 inside compose.
# QDRANT_URL=http://localhost:6333

# --- Embeddings (local, no API key) ---
# BAAI/bge-m3 via sentence-transformers, CPU, 8192 context, 1024d
# Matryoshka, normalized for cosine. Weights (~2GB) download
# on first run and are cached to the Docker volume `hf_cache` (HF_HOME).
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# --- Chat provider ---
# Chat provider, model, and API key are stored as global app settings
# configured in the app's Settings dialog (encrypted with APP_SECRET).
# No per-provider env vars are needed.

# --- App secret ---
# Secret that derives the Fernet key (HKDF-SHA256) for encrypting the
# stored provider API key. When unset, a warning is printed and stored keys
# cannot be encrypted or decrypted. Set this in any persistent deployment;
# changing it invalidates previously stored keys.
# APP_SECRET=change-me

# --- Reranker (gated local cross-encoder over the 50 hybrid candidates) ---
# RERANK: true|false — when true, reranks the 50 hybrid candidates with a
# local cross-encoder before keeping top 5. Default false.
# Entirely local CPU, no API. Two models via RERANK_MODEL:
#   - cross-encoder/ms-marco-MiniLM-L-6-v2 (22M, ~10ms/50 docs, fast, default)
#   - BAAI/bge-reranker-v2-m3 (~80ms/50 docs, quality)
# RERANK=false
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking (token-based, owned by the parser) ---
# CHUNK_SIZE_TOKENS: tokens per chunk via tiktoken cl100k_base (default 512 ~2000 chars)
# CHUNK_OVERLAP_TOKENS: overlap between chunks (default 50 ~10%)
# Override to trade context for latency; tests assert 512±20 tokens overlap preservation.
# CHUNK_SIZE_TOKENS=512
# CHUNK_OVERLAP_TOKENS=50

# --- Parser (opt-in Docling layout-aware branch) ---
# USE_DOCLING: auto (default) | true | false
# - auto: lightweight heuristic routes only image-only / borderless-table /
#   2-col PDFs to Docling; others stay on pymupdf fast path.
# - true: force Docling for all PDFs (requires `.[docling]` extra).
# - false: never use Docling, always pymupdf.
# Heavy deps (`docling` + `granite-docling-258M` ~1.1GB) are behind the
# optional extra `.[docling]` (`uv sync --extra docling` / `pip install ".[docling]"`)
# and cached to the Docker volume `hf_cache` (HF_HOME). `uv run pytest` mocks
# the parser and never downloads.
# USE_DOCLING=auto

# --- Local storage ---
# Optional: directory for uploaded PDFs (default: backend/data/storage)
# STORAGE_DIR=/absolute/path/to/uploads
