# Local infrastructure secrets for `docker compose -f backend/compose.yaml up -d`.
# Copy handling is done by backend/scripts/bootstrap-local.sh — do not commit
# the generated backend/.infra.env file. Every value below is local-only.
POSTGRES_USER=papermind
# Random per machine (bootstrap generates with secrets.token_urlsafe). Never a
# shared default: compose refuses to start without a real value here.
POSTGRES_PASSWORD=replace-me-run-bootstrap-local-sh
# Qdrant needs no API key on loopback, so this stays empty. Exposing it beyond
# 127.0.0.1 means exporting QDRANT_API_KEY in the shell (compose reads it for
# the compose.qdrant-auth.yaml overlay) and setting the same value in
# backend/.env as QDRANT_API_KEY.
QDRANT_API_KEY=
